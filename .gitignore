__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.duckdb
*.sqlite
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# data & runtime state are large/derived/sensitive - never commit
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
logs/*
!logs/.gitkeep
state/*
!state/.gitkeep
reports/backtests/*
reports/walkforward/*
reports/forward_test/*
reports/weekly/*
!reports/**/.gitkeep
