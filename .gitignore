__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.duckdb
*.sqlite
# database/quant_lab.db is a derived index rebuilt from the tracked CSVs/
# JSON reports by scripts/build_research_database.py (run it each session
# after cloning) - see that script's own docstring for why it isn't the
# source of truth and isn't committed.
database/*.db
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# data & runtime state are normally large/derived/sensitive - not committed
# by default. Exception: this environment's containers are ephemeral and
# re-cloned from git each session, so anything meant to survive across
# sessions (the shadow/forward-test ledger, small research data snapshots)
# has to actually be committed - git is the only persistence this project
# has. See src/futures_quant/persistence/ledger.py.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
# small, deliberately-committed real data samples (see data/metadata/ for
# provenance) - not a place for bulk/multi-year research data.
!data/raw/MES/
!data/raw/MGC/
!data/raw/MCL/
!data/raw/MBT/
logs/*
!logs/.gitkeep
state/*
!state/.gitkeep
!state/paper_shadow/
reports/backtests/*
reports/walkforward/*
reports/forward_test/*
reports/weekly/*
!reports/**/.gitkeep
# small, deliberately-committed backtest result reports (same ephemeral-
# container rationale as data/raw/ above) - not a place for bulk reports.
!reports/backtests/*.json
