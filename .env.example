# Copy to .env for local development. Never commit the real .env file.

# --- IBKR TWS / IB Gateway connection (PAPER instance only) ---
# Standard paper-trading ports: TWS paper=7497, IB Gateway paper=4002.
# Standard live ports (7496 / 4001) must NEVER be used by this project.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=101

# The account id prefix IBKR paper accounts use. Real account ids are never
# committed; this is only used to validate the prefix returned at runtime.
IBKR_EXPECTED_ACCOUNT_PREFIX=DU

# --- Database ---
FUTURES_QUANT_DB_PATH=state/futures_quant.duckdb

# --- Alerting (optional) ---
ALERT_WEBHOOK_URL=

# --- External data providers (optional, for history beyond IBKR's depth) ---
DATABENTO_API_KEY=
